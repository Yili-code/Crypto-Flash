[{"ts": 1790358620.4715087, "title": "", "content": "2026年FOMC票委、克利夫兰联储主席哈玛克将于十分钟后发表讲话。", "tier": null, "summary": "", "relevant": null, "id": "20260926015000000800"}, {"ts": 1790359562.065673, "title": "", "content": "美联储哈玛克：通胀面临的最大风险是形成“通胀心态”。", "tier": null, "summary": "", "relevant": null, "id": "20260926020601940800"}, {"ts": 1790359574.116843, "title": "", "content": "美联储哈玛克：公众已经在较长时间内承受高于目标水平的通胀。", "tier": null, "summary": "", "relevant": null, "id": "20260926020613991800"}, {"ts": 1790359582.375377, "title": "", "content": "美联储哈玛克：经济增长保持良好，劳动力市场稳定。", "tier": null, "summary": "", "relevant": null, "id": "20260926020622234800"}, {"ts": 1790359608.5991204, "title": "", "content": "美联储哈玛克：担心需求相关压力推高通胀。", "tier": null, "summary": "", "relevant": null, "id": "20260926020648455800"}, {"ts": 1790359630.2694302, "title": "", "content": "美联储哈玛克：资本支出将在一段时间内给通胀带来压力。", "tier": null, "summary": "", "relevant": null, "id": "20260926020710127800"}, {"ts": 1790359649.262215, "title": "", "content": "美联储哈玛克：如果我们未能在降低通胀方面取得进展，通胀预期可能会发生变化。", "tier": null, "summary": "", "relevant": null, "id": "20260926020729108800"}, {"ts": 1790359680.1867766, "title": "", "content": "美联储哈玛克：美联储需要确保货币政策处于限制性立场，以降低通胀。", "tier": null, "summary": "", "relevant": null, "id": "20260926020800044800"}, {"ts": 1790359760.9574943, "title": "", "content": "美联储哈玛克：我们在需求端和供应端都面临压力。", "tier": null, "summary": "", "relevant": null, "id": "20260926020920834800"}, {"ts": 1790360596.040797, "title": "", "content": "美联储哈玛克：关于人工智能将如何影响通胀，仍存在许多长期问题。", "tier": null, "summary": "", "relevant": null, "id": "20260926022315901800"}, {"ts": 1790360609.0890775, "title": "", "content": "美联储哈玛克：潜在通胀可能高于目标。", "tier": null, "summary": "", "relevant": null, "id": "20260926022328941800"}, {"ts": 1790360903.9519973, "title": "", "content": "美联储哈玛克：美联储双重使命的两个方面通常并不冲突。", "tier": null, "summary": "", "relevant": null, "id": "20260926022823826800"}, {"ts": 1790360915.6191008, "title": "", "content": "美联储哈玛克：持续高企的通胀会带来“实际成本”。", "tier": null, "summary": "", "relevant": null, "id": "20260926022835491800"}, {"ts": 1790360943.8844113, "title": "", "content": "美联储哈玛克：持续高企的通胀会对工资造成压力。", "tier": null, "summary": "", "relevant": null, "id": "20260926022903756800"}, {"ts": 1790361191.9351532, "title": "", "content": "美联储哈玛克：美联储兑现其通胀使命非常重要。", "tier": null, "summary": "", "relevant": null, "id": "20260926023311796800"}, {"ts": 1790361198.039399, "title": "", "content": "美联储哈玛克：高通胀使经济规划变得复杂。", "tier": null, "summary": "", "relevant": null, "id": "20260926023317915800"}, {"ts": 1790361202.243784, "title": "", "content": "美联储哈玛克：美联储政策并未抑制住房以外的经济活动。", "tier": null, "summary": "", "relevant": null, "id": "20260926023322109800"}, {"ts": 1790361204.813778, "title": "", "content": "美联储哈玛克：我认为我们的政策立场并未抑制经济投资。", "tier": null, "summary": "", "relevant": null, "id": "20260926023324677800"}, {"ts": 1790361285.1799016, "title": "", "content": "美联储哈玛克：我认为我们的政策立场并未抑制经济投资。", "tier": null, "summary": "", "relevant": null, "id": "20260926023445057800"}, {"ts": 1790362033.1706667, "title": "美媒：白宫拟采取柴油降价措施 但不会禁止出口", "content": "金十数据9月26日讯，三位知情人士表示，特朗普政府正在考虑通过其他措施缓解柴油价格压力，而非实施柴油出口禁令。知情人士称，政府正在考虑通过增加农业、建筑等行业使用的免税柴油供应，以及推动更多州取消柴油税等方式缓解高油价压力。报道援引消息人士称，特朗普政府最快可能于本周五或下周初公布相关政策，但目前尚未作出最终决定。", "tier": null, "summary": "", "relevant": null, "id": "20260926024713032800"}, {"ts": 1790362075.8319101, "title": "", "content": "美联储哈玛克：债券收益率上升受多种因素驱动。", "tier": null, "summary": "", "relevant": null, "id": "20260926024755691800"}, {"ts": 1790362084.8302982, "title": "", "content": "美联储哈玛克：良好的经济前景正在推高债券收益率。", "tier": null, "summary": "", "relevant": null, "id": "20260926024804695800"}, {"ts": 1790362103.6046977, "title": "", "content": "美联储哈玛克：债券市场的部分表现是对美联储和政府政策的反应。", "tier": null, "summary": "", "relevant": null, "id": "20260926024823450800"}, {"ts": 1790362117.5911775, "title": "", "content": "美联储哈玛克：美国正走在不可持续的财政道路上。", "tier": null, "summary": "", "relevant": null, "id": "20260926024837466800"}, {"ts": 1790362141.9623146, "title": "", "content": "美联储哈玛克：人工智能投资需求正在与债券市场争夺投资者资金。", "tier": null, "summary": "", "relevant": null, "id": "20260926024901838800"}, {"ts": 1790362189.1871238, "title": "", "content": "美联储哈玛克：通胀预期目前仍保持相对稳定。", "tier": null, "summary": "", "relevant": null, "id": "20260926024949040800"}, {"ts": 1790362246.5203116, "title": "", "content": "美联储哈玛克：关注金融状况，但货币政策由美联储决定。", "tier": null, "summary": "", "relevant": null, "id": "20260926025046389800"}, {"ts": 1790362578.901406, "title": "", "content": "欧洲央行副行长武伊契奇：经历多轮供给冲击后，不再像过去一样将核心通胀作为主要判断依据。", "tier": null, "summary": "", "relevant": null, "id": "20260926025618760800"}, {"ts": 1790362700.0486302, "title": "", "content": "美联储哈玛克：在当前环境下，美联储需要保持政策灵活性，这限制了前瞻指引的空间。", "tier": null, "summary": "", "relevant": null, "id": "20260926025819924800"}, {"ts": 1790365641.3064342, "title": "", "content": "据相关法院文件：美国上诉法院裁定Kalshi败诉，称各州可以监管其事件合约。", "tier": "MEDIUM", "summary": "<b>美國法院裁定 Kalshi 敗訴並允許各州監管事件合約</b>\n\n美國上訴法院裁定預測市場平台 Kalshi 敗訴，確認各州有權對其事件合約進行監管。\n\n<b>Crypto</b>\n事件合約與預測市場面臨更嚴格的合規壓力，短期內可能對加密原生預測市場及相關衍生品協議的監管預期帶來不確定性。", "relevant": true, "id": "20260926034719884800"}, {"ts": 1790369090.3701425, "title": "美联储哈马克：美债收益率上涨并非源于通胀信心丧失", "content": "金十数据9月26日讯，克利夫兰联储主席贝丝·哈马克表示，近期美债收益率大幅上升并非由于市场失去对通胀回落的信心，而是主要受到实际利率上升、强劲经济前景、财政政策以及投资者资金竞争等因素推动。她表示，当前通胀预期仍“基本保持良好锚定”，但持续高于美联储2%目标的通胀仍带来实际成本，并可能影响经济规划和工资压力。哈马克表示，目前通胀最大风险是形成“通胀心态”，即公众开始认为高通胀将长期持续。她指出，通胀已连续多年高于目标水平，美联储需要确保货币政策保持限制性立场，以推动通胀回落至2%目标。在债市方面，哈马克表示，收益率上升部分反映市场对美联储政策和政府财政政策的重新定价，同时AI和科技行业投资需求也在与债券市场争夺投资资金。她还表示，美国当前财政路径不可持续。", "tier": "HIGH", "summary": "<b>克利夫蘭聯儲主席談美債收益率與Inflation風險</b>\n\n聯儲官員指出近期美債收益率上升主因非通脹信心喪失，而是實際利率與強勁經濟前景驅動，並強調須防範Inflation心態形成。\n\n<b>Crypto</b>\nFed維持限制性貨幣政策立場的預期持續壓抑市場Liquidity，短期內對Crypto資產帶來審慎觀望情緒。", "relevant": true, "id": "20260926044449081800"}]