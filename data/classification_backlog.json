[{"id": "20261026203803500800", "queued_at": 1793018291.8387012, "last_attempt_at": 1793018291.8387012, "attempts": 1, "item": {"action": 1, "channel": [1, 2, 3], "data": {"content": "【美国民主党要求银行和港口保留美俄柴油交易相关记录】金十数据10月26日讯，据AXIOS援引相关信件报道，有望在明年担任重要职务的民主党高层正要求大型银行和港口保留与潜在进口或其他涉及俄罗斯柴油的交易相关的所有记录。如果民主党赢得国会任一院或两院的控制权，调查特朗普与莫斯科达成的协议将成为优先事项。", "exclusive_to": [], "pic": "", "source": "", "source_link": "", "title": ""}, "extras": {"ad": false}, "id": "20261026203803500800", "important": 1, "kinds": [{"cids": [18602], "id": 24}, {"cids": [32, 33], "id": 31}, {"cids": [17958], "id": 17952}, {"cids": [16171], "id": 29}, {"cids": [16916], "id": 16497}, {"cids": [18754], "id": 18458}], "remark": [], "tags": [], "time": "2026-10-26 20:38:03", "type": 0, "_metrics_received_at": 1793018283.6464615}}, {"id": "20261026204448444800", "queued_at": 1793018688.6451235, "last_attempt_at": 1793018688.6451235, "attempts": 1, "item": {"action": 1, "channel": [2], "data": {"content": "【宏观情绪修复叠加基本面去库，锡价震荡偏强】金十期货10月26日讯，金瑞期货10月26日研报显示，今日沪锡主力合约收报384,880元/吨，涨1.71%，延续反弹走势。宏观情绪边际修复，前期风险偏好回落带来的压制有所缓解，叠加内外盘库存持续去化为价格提供支撑。基本面方面，矿端供应仍偏紧，缅甸复产缓慢，印尼截至目前出口约1885吨，供应不及预期；国内云南大型冶炼厂处于检修期，冶炼开工偏低；上期所锡仓单降至1982吨，跌破2000吨关口，LME库存降至4045吨，现货升水维持高位，持货商挺价意愿较强。需求端下游随价格反弹、采购节奏放缓，成交有限。展望后市，矿端偏紧与去库提供支撑，但宏观扰动及旺季不及预期仍限制上行空间，短期预计维持高位宽幅震荡，后续关注美联储议息决议、半导体板块景气度以及供应修复等情况。（本内容及观点仅供参考，不构成任何投资建议）", "exclusive_to": [], "pic": "", "source": "", "source_link": "", "title": ""}, "extras": {"ad": false}, "id": "20261026204448444800", "important": 0, "kinds": [{"cids": [17937, 18587, 111], "id": 1}, {"cids": [16580], "id": 16498}, {"cids": [16203], "id": 29}, {"cids": [17958], "id": 17952}, {"cids": [18467], "id": 18458}, {"cids": [18587], "id": 2}, {"cids": [18328], "id": 17}, {"cids": [16505], "id": 25}, {"cids": [17580, 18375], "id": 23}], "remark": [], "tags": [], "time": "2026-10-26 20:44:48", "type": 0, "_metrics_received_at": 1793018688.643702}}, {"id": "20261026204523935800", "queued_at": 1793018724.1169598, "last_attempt_at": 1793018724.1169598, "attempts": 1, "item": {"action": 1, "channel": [1, 2, 3], "data": {"content": "<b>巴西2035年1月到期的利率合约跳涨263个基点至15.375%。</b>", "exclusive_to": [], "pic": "", "source": "", "source_link": "", "title": ""}, "extras": {"ad": false}, "id": "20261026204523935800", "important": 0, "kinds": [{"cids": [16319], "id": 29}, {"cids": [17958], "id": 17952}], "remark": [], "tags": [], "time": "2026-10-26 20:45:23", "type": 0, "_metrics_received_at": 1793018724.115613}}, {"id": "20261026204637664800", "queued_at": 1793018797.8462682, "last_attempt_at": 1793018797.8462682, "attempts": 1, "item": {"action": 1, "channel": [3, 4, 5], "data": {"content": "【中国驻英国使馆发言人：欧洲产业的困境根源在于其自身的结构性问题】金十数据10月26日讯，中国驻英国使馆发言人就部分媒体炒作所谓“中国制造业崛起对西方高端产业形成冲击”答记者问表示，欧洲产业的困境根源在于其自身的结构性问题——产业空心化、经济过度金融化、研发投入不足、短期资本逐利导致制造业外迁等。将自身产业困境片面归咎于中国出口，是对自身政策失误的掩盖。中国作为全球制造业供应链的核心环节，长期以来为西方国家提供了大量质优价廉的工业制成品，有效降低了其民众的生活成本、缓解了通胀压力。欧洲的高端装备通过与中国制造业的深度融合，实现了优势互补、利益共享、双向赋能。中国制造业的发展非但没有冲击西方国家，反而为全球经济稳定和西方产业发展提供了重要支撑。", "exclusive_to": [], "pic": "", "source": "中国驻英国大使馆", "source_link": "https://gb.china-embassy.gov.cn/lcbt/sgryr/202610/t20261026_12047161.htm", "title": ""}, "extras": {"ad": false}, "id": "20261026204637664800", "important": 0, "kinds": [{"cids": [16304, 16122], "id": 29}, {"cids": [32], "id": 31}, {"cids": [17953, 17958], "id": 17952}], "remark": [], "tags": [], "time": "2026-10-26 20:46:37", "type": 0, "_metrics_received_at": 1793018797.8449116}}, {"id": "20261026204955700800", "queued_at": 1793018995.8758318, "last_attempt_at": 1793018995.8758318, "attempts": 1, "item": {"action": 1, "channel": [1, 2, 3], "data": {"content": "<b>巴西财政部取消原定于10月29日举行的固定利率政府债券拍卖。</b>", "exclusive_to": [], "pic": "", "source": "", "source_link": "", "title": ""}, "extras": {"ad": false}, "id": "20261026204955700800", "important": 0, "kinds": [{"cids": [16319], "id": 29}, {"cids": [17448], "id": 16502}, {"cids": [17958], "id": 17952}], "remark": [], "tags": [], "time": "2026-10-26 20:49:55", "type": 0, "_metrics_received_