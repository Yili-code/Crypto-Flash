s": [18472, 18754, 18491, 18528], "id": 18458}, {"cids": [34, 35, 36, 39, 28], "id": 2}, {"cids": [34, 35, 99, 36, 76, 109, 28], "id": 1}, {"cids": [16938, 16916], "id": 16497}, {"cids": [18328], "id": 17}, {"cids": [3121], "id": 16}, {"cids": [16375], "id": 30}, {"cids": [18494], "id": 16502}, {"cids": [16505], "id": 25}], "remark": [], "tags": [], "time": "2026-10-15 15:03:00", "type": 0, "_metrics_received_at": 1792047780.3557277}}, {"id": "20261015151030423800", "queued_at": 1792048230.5696998, "last_attempt_at": 1792048230.5696998, "attempts": 1, "item": {"action": 1, "channel": [1, 2, 3], "data": {"content": "【纽约人寿投资管理：美国经济韧性暗示中性利率或更高，偏好短期限信用债】金十数据10月15日讯，纽约人寿投资管理公司全球市场策略师朱莉娅·赫尔曼在一份报告中表示，美国经济展现出的韧性意味着，中性政策利率可能高于此前的预期。不过，赫尔曼指出，如果美国国债收益率进一步上升，可能开始威胁到经济增长本身的韧性，而正是这种韧性使市场迄今能够承受金融环境收紧带来的压力。她表示，市场能否维持最有利的状态，关键取决于较高利率是否仍然反映经济基本面的强劲表现。在投资配置方面，纽约人寿投资管理公司更青睐短期限、低久期信用债，认为这类资产具有颇具吸引力的收益获取潜力。赫尔曼表示：“鉴于长期限债券收益率仍然波动较大，我们认为，投资者通过延长久期所获得的额外风险补偿十分有限。”", "exclusive_to": [], "pic": "", "source": "", "source_link": "", "title": ""}, "extras": {"ad": false}, "id": "20261015151030423800", "important": 0, "kinds": [{"cids": [18545], "id": 18458}, {"cids": [16121], "id": 29}, {"cids": [17953, 17958], "id": 17952}, {"cids": [32], "id": 31}, {"cids": [69], "id": 1}], "remark": [], "tags": [], "time": "2026-10-15 15:10:30", "type": 0, "_metrics_received_at": 1792048230.5694752}}]