TELEGRAM_BOT_TOKEN_01="" #jin10_monitor and telegram assistant
TELEGRAM_BOT_TOKEN_02="" # yt_monitor
TELEGRAM_CHAT_ID=""
# Optional comma-separated Telegram user IDs allowed to run paid AI and shared-state commands.
# Leave empty only when every member of the configured chat is trusted.
TELEGRAM_OWNER_USER_IDS=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_YOUTUBE_DAILY_REQUESTS=120
GEMINI_LIVE_DAILY_REQUESTS=600
MAX_TIER_TO_SEND=HIGH
# MEDIUM and LOW are always discarded before storage; this can narrow pushes to CRITICAL.
# Counts all attempted requests (including failures/probes), resets at 00:00 UTC+8.
# 0 pauses calls; -1 disables the local request-count cap (not provider limits).
GEMINI_POLICY_REVISION=""
# Change this after fixing external account settings to clear error blocks,
# without resetting today's consumed request count.
NEWS_FEEDS_FILE="config/news_feeds.json"
FEED_POLL_INTERVAL=120
# RSS/Atom sources are warmed on first use, so existing history is not replayed.
CRYPTOFLASH_STATE_DIR="data"
# Point this outside the repository (or to a private mounted volume) to keep runtime state out of Git.
CLASSIFICATION_BACKLOG_MAX_ITEMS=500
CLASSIFICATION_BACKLOG_MAX_AGE_SEC=3600
MONITORING_FLUSH_INTERVAL=30

